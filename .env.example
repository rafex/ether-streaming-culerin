# Variables del puente (copiar a .env; .env NUNCA se versiona — regla 13).
# Referencia completa: docs/configuration.md

# Obligatorias fuera del modo desarrollo
BRIDGE_ADMIN_TOKEN=cambia-esto-por-un-token-largo-aleatorio
BRIDGE_INVITE_SECRET=cambia-esto-por-32-o-mas-caracteres-aleatorios

# URL pública del webrelay (para los enlaces de invitación)
BRIDGE_WEBRELAY_URL=http://localhost:5173
# Orígenes del webrelay permitidos en /signal (host[:puerto], comodín *)
BRIDGE_ALLOWED_ORIGINS=localhost:*,127.0.0.1:*

# ICE: IP anunciada a los navegadores (contenedor/NAT 1:1) y puerto UDP único
BRIDGE_ICE_PUBLIC_IPS=127.0.0.1
BRIDGE_ICE_UDP_PORT=8443
# BRIDGE_ICE_SERVERS=[{"urls":["stun:stun.l.google.com:19302"]}]

# BRIDGE_DEV_MODE=false
# BRIDGE_LOG_LEVEL=info
# BRIDGE_RECORD_DIR=/var/lib/bridge/recordings
