# Imagen de CI (regla 06): toolchain Go + FFmpeg para las pruebas de integración
# del compositor. Base fijada por digest (regla 08).
FROM docker.io/library/golang:1.27.2-trixie@sha256:47667934874913a449b96faa7ef4777fa285d9ec29126ee80ed61c45b7cccf0e

RUN apt-get update \
	&& apt-get install -y --no-install-recommends ffmpeg fonts-dejavu-core make curl \
	&& rm -rf /var/lib/apt/lists/*

ENV GOFLAGS=-buildvcs=false \
	GOTOOLCHAIN=local

WORKDIR /workspace
ENTRYPOINT ["/bin/bash", "-c"]
CMD ["make ci-local"]
